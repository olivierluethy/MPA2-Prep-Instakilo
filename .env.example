# Copy to .env and adjust as needed: `cp .env.example .env`
# docker compose reads this file automatically.

# ----- Application -----
APP_NAME=Instakilo
APP_ENV=development          # development | production
APP_DEBUG=true               # set false in production
APP_PORT=8080                # host port -> app (http://localhost:8080)
# APP_BASE_PATH=             # only if served from a sub-directory

# ----- Database (consumed by both the db and app services) -----
DB_NAME=instakilo
DB_USER=instakilo
DB_PASSWORD=instakilo
DB_ROOT_PASSWORD=rootsecret
DB_PORT_HOST=3307            # host port -> MySQL (for local DB tools)

# ----- Uploads -----
UPLOAD_MAX_FILE_SIZE=5242880 # 5 MB per image (bytes)
UPLOAD_MAX_FILES=10          # images per post
